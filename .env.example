# Trend Pipeline — Environment Variables Template
# Copy to .env and fill in your API keys
# ⚠️  Never commit .env to version control — it contains real keys.

# ---- Server ----
TREND_HOST=0.0.0.0
TREND_PORT=8765

# ---- Google Trends Proxy (optional) ----
# GT_PROXY=https://user:***@residential-proxy:port

# ══════════════════════════════════════════════
# NEWS API KEYS — Sign up at the links below
# ══════════════════════════════════════════════

# NewsAPI.org — https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Mediastack — https://mediastack.com
MEDIASTACK_KEY=your_mediastack_key_here

# GNews — https://gnews.io
GNEWS_KEY=your_gnews_key_here

# Currents API — https://currentsapi.services
CURRENTS_KEY=your_currents_key_here

# ══════════════════════════════════════════════
# REDDIT API — https://www.reddit.com/prefs/apps
# Select "script" type, set redirect_uri to http://localhost:8080
# ══════════════════════════════════════════════
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DigitalBrief/1.0


# ------------------------------------------------
# MORE NEWS APIS (added 2026-08-14)
# ------------------------------------------------

# Webz.io News API Lite - https://webz.io
WEBZIO_API_KEY=your_webzio_api_key

# APITube News API - https://apitube.io
APITUBE_API_KEY=your_apitube_api_key

# The News API - https://www.thenewsapi.com
THENEWS_API_KEY=your_thenewsapi_key

# NYTimes - https://developer.nytimes.com
NYT_API_KEY=your_nyt_api_key
NYT_APP_ID=your_nyt_app_id

# MediaCloud - https://mediacloud.org
MEDIACLOUD_API_KEY=your_mediacloud_api_key
